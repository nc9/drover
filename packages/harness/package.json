{
  "name": "@droveragent/harness",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "typecheck": "tsgo --noEmit",
    "test": "bun test",
    "build": "tsc -p tsconfig.build.json && bun run ../../scripts/postbuild-dts.ts",
    "prepublishOnly": "tsc -p tsconfig.build.json && bun run ../../scripts/postbuild-dts.ts"
  },
  "dependencies": {
    "@droveragent/commands": "workspace:*",
    "@droveragent/core": "workspace:*",
    "@droveragent/mcp": "workspace:*",
    "@droveragent/memory": "workspace:*",
    "@droveragent/model": "workspace:*",
    "@droveragent/prompt": "workspace:*",
    "@droveragent/sandbox": "workspace:*",
    "@droveragent/skills": "workspace:*",
    "@droveragent/storage": "workspace:*",
    "@droveragent/tools": "workspace:*",
    "@mariozechner/pi-agent-core": "^0.73.1",
    "@mariozechner/pi-ai": "^0.73.1",
    "@sinclair/typebox": "^0.34.0",
    "effect": "^3.10.0"
  },
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  }
}
