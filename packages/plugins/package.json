{
  "name": "@droveragent/plugins",
  "version": "0.1.0",
  "private": false,
  "homepage": "https://nc9.github.io/drover/",
  "bugs": {
    "url": "https://github.com/nc9/drover/issues"
  },
  "license": "MIT",
  "author": "Nik Cubrilovic",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nc9/drover.git",
    "directory": "packages/plugins"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./loop-detect": {
      "types": "./dist/loop-detect.d.ts",
      "import": "./dist/loop-detect.js"
    },
    "./step-tracer": {
      "types": "./dist/step-tracer.d.ts",
      "import": "./dist/step-tracer.js"
    },
    "./bash-blocklist": {
      "types": "./dist/bash-blocklist.d.ts",
      "import": "./dist/bash-blocklist.js"
    },
    "./circuit-breaker": {
      "types": "./dist/circuit-breaker.d.ts",
      "import": "./dist/circuit-breaker.js"
    },
    "./write-policy": {
      "types": "./dist/write-policy.d.ts",
      "import": "./dist/write-policy.js"
    },
    "./phase-recorder": {
      "types": "./dist/phase-recorder.d.ts",
      "import": "./dist/phase-recorder.js"
    },
    "./confirm-gate": {
      "types": "./dist/confirm-gate.d.ts",
      "import": "./dist/confirm-gate.js"
    },
    "./dedup": {
      "types": "./dist/dedup.d.ts",
      "import": "./dist/dedup.js"
    },
    "./output-validate": {
      "types": "./dist/output-validate.d.ts",
      "import": "./dist/output-validate.js"
    },
    "./truncate": {
      "types": "./dist/truncate.d.ts",
      "import": "./dist/truncate.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsgo --noEmit",
    "test": "bun test",
    "build": "tsc -p tsconfig.build.json && bun run ../../scripts/postbuild-dts.ts",
    "prepublishOnly": "tsc -p tsconfig.build.json && bun run ../../scripts/postbuild-dts.ts"
  },
  "dependencies": {
    "@droveragent/core": "workspace:*",
    "@sinclair/typebox": "^0.34.0",
    "effect": "^3.10.0"
  }
}
