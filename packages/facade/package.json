{
  "name": "@droveragent/facade",
  "version": "0.2.0",
  "private": false,
  "homepage": "https://nc9.github.io/drover/",
  "bugs": {
    "url": "https://github.com/nc9/drover/issues"
  },
  "license": "MIT",
  "author": "Nik Cubrilovic",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nc9/drover.git",
    "directory": "packages/facade"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsgo --noEmit",
    "test": "bun test",
    "build": "tsc -p tsconfig.build.json && bun run ../../scripts/postbuild-dts.ts",
    "prepublishOnly": "tsc -p tsconfig.build.json && bun run ../../scripts/postbuild-dts.ts"
  },
  "dependencies": {
    "@droveragent/core": "workspace:*",
    "@droveragent/harness": "workspace:*",
    "@droveragent/model": "workspace:*",
    "@droveragent/sandbox": "workspace:*",
    "@droveragent/sandbox-just-bash": "workspace:*",
    "@droveragent/storage": "workspace:*",
    "@sinclair/typebox": "^0.34.0",
    "effect": "^3.10.0"
  }
}
