{
  "name": "@droveragent/sandbox-just-bash",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "typecheck": "tsgo --noEmit",
    "test": "bun test",
    "build": "tsc -p tsconfig.build.json && bun run ../../scripts/postbuild-dts.ts",
    "prepublishOnly": "tsc -p tsconfig.build.json && bun run ../../scripts/postbuild-dts.ts"
  },
  "dependencies": {
    "@droveragent/core": "workspace:*",
    "@droveragent/sandbox": "workspace:*",
    "effect": "^3.10.0",
    "just-bash": "^3.0.1"
  },
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  }
}
